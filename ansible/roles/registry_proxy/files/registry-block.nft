table inet k3s_registry {
  set registries4 {
    type ipv4_addr
    flags interval
  }

  set registries6 {
    type ipv6_addr
    flags interval
  }

  chain output {
    type filter hook output priority filter
    policy accept
    tcp dport 443 ip daddr @registries4 reject with tcp reset
    tcp dport 443 ip6 daddr @registries6 reject with tcp reset
  }
}
