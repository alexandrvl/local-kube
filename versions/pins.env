# Pinned platform versions. Chart versions are recorded in versions/charts.env
# after the helm repositories are indexed. App versions are upstream releases
# current as of the bootstrap date.

# k3s stable channel was v1.37.2+k3s1. Cilium v1.20.5 e2e coverage is
# Kubernetes 1.33-1.36, so the cluster pins the newest 1.36 patch instead.
K3S_VERSION=v1.36.6+k3s1
KUBERNETES_VERSION=v1.36.6

CILIUM_VERSION=v1.20.5
HAPROXY_INGRESS_VERSION=v3.4.1
CERT_MANAGER_VERSION=v1.21.3
ARGO_CD_VERSION=v3.6.3
GITEA_VERSION=v28.4.0
VAULT_VERSION=v2.2.2
VAULT_HELM_VERSION=v0.34.1
ALLOY_VERSION=v1.22.0
MIMIR_VERSION=mimir-3.2.6
LOKI_VERSION=v3.7.10
# Chart 10.5.15 ships Grafana 12.3.1. Upstream 13.3.2 is not in that chart.
GRAFANA_VERSION=v12.3.1
# Chart 1.19.4 ships Harbor 2.15.4. Upstream 2.15.5 is one patch ahead.
HARBOR_VERSION=v2.15.4
KYVERNO_VERSION=v1.20.0
FALCO_VERSION=0.45.2
OPENCOST_VERSION=v1.121.5
PODINFO_VERSION=6.17.0
HELM_VERSION=v4.3.2
OPENTOFU_VERSION=1.13.10
ANSIBLE_CORE_VERSION=2.22.0
MULTIPASS_PROVIDER_VERSION=2.3.1
VSPHERE_PROVIDER_VERSION=2.18.0
PROXMOX_PROVIDER_VERSION=0.124.0

# Lab shape. Host is 4 vCPU / 19 GiB and already runs the agent-sandbox
# Multipass VM (6 vCPU / 12 GiB). After the k3s VMs are stopped, about 12 GiB
# is available. Each node is 5G so at least 2 GiB stays for the host.
K3S_SERVER_CPUS=2
K3S_SERVER_MEMORY=5G
K3S_SERVER_DISK=30G
K3S_AGENT_CPUS=2
K3S_AGENT_MEMORY=5G
K3S_AGENT_DISK=30G
UBUNTU_IMAGE=24.04
CLUSTER_POD_CIDR=10.42.0.0/16
CLUSTER_SERVICE_CIDR=10.43.0.0/16
LAB_DOMAIN=lab.test
