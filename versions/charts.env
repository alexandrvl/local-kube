# Helm chart pins. App versions are the chart appVersion unless noted.
# Chosen as the newest chart release that matches a current, compatible app.

CILIUM_CHART=1.20.5
CILIUM_APP=1.20.5
HAPROXY_INGRESS_CHART=1.57.1
HAPROXY_INGRESS_APP=3.4.1
CERT_MANAGER_CHART=v1.21.3
CERT_MANAGER_APP=v1.21.3
ARGO_CD_CHART=10.20.0
ARGO_CD_APP=v3.6.3
# Gitea is installed from a manifest, not the chart. The newest chart (12.7.0)
# still packages 1.27.0, which is behind upstream 28.4.0.
GITEA_IMAGE=docker.io/gitea/gitea:28.4.0
VAULT_CHART=0.34.1
VAULT_APP=2.2.2
ALLOY_CHART=1.16.0
ALLOY_APP=v1.22.0
GRAFANA_CHART=10.5.15
# Chart appVersion is 12.3.1. Upstream Grafana is 13.3.2, which this chart does not ship.
GRAFANA_APP=12.3.1
HARBOR_CHART=1.19.4
HARBOR_APP=2.15.4
KYVERNO_CHART=3.10.0
KYVERNO_APP=v1.20.0
FALCO_CHART=9.2.2
FALCO_APP=0.45.2
OPENCOST_CHART=2.5.35
OPENCOST_APP=1.121.5
MIMIR_IMAGE=grafana/mimir:3.2.6
LOKI_IMAGE=grafana/loki:3.7.10
PODINFO_IMAGE=ghcr.io/stefanprodan/podinfo:6.17.0
